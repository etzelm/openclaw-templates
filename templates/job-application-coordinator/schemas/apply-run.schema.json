{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/openclaw/awesome-claws/schemas/apply-run.schema.json",
  "title": "Apply run report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "runId", "startedAt", "timeZone", "mode", "postings", "capCount", "endReason", "database", "digestSent"],
  "properties": {
    "schemaVersion": { "const": "awesomeClaws.applyRun.v1" },
    "runId": { "type": "string", "minLength": 1, "maxLength": 120 },
    "startedAt": { "type": "string", "format": "date-time" },
    "timeZone": { "type": "string", "minLength": 1, "maxLength": 64 },
    "mode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dryRun", "confirmBeforeSubmit"],
      "properties": {
        "dryRun": { "type": "boolean" },
        "confirmBeforeSubmit": { "type": "boolean" }
      }
    },
    "postings": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "company", "title", "link", "status", "submittedBy", "gate", "attempts", "autoRetries", "fitReason", "steps", "note"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 120 },
          "company": { "type": "string", "minLength": 1, "maxLength": 200 },
          "title": { "type": "string", "minLength": 1, "maxLength": 200 },
          "link": { "type": "string", "format": "uri" },
          "status": {
            "enum": ["prospect", "ready-for-owner-review", "applied", "interviewing", "offer-review", "closed", "skipped", "dry-run", "held", "handoff"]
          },
          "submittedBy": { "enum": ["owner", "agent", "none"] },
          "gate": { "enum": ["none", "cleared", "held", "handoff"] },
          "attempts": { "type": "integer", "minimum": 0, "maximum": 2 },
          "autoRetries": { "type": "integer", "minimum": 0, "maximum": 1 },
          "fitReason": { "type": "string", "maxLength": 300 },
          "flaggedAnswers": { "type": "array", "maxItems": 20, "items": { "type": "string", "minLength": 1, "maxLength": 300 } },
          "answerSources": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["field", "source"],
              "properties": {
                "field": { "type": "string", "minLength": 1, "maxLength": 300 },
                "source": { "enum": ["answers", "resume", "profile", "computed"] },
                "flagged": { "type": "boolean" }
              }
            }
          },
          "markerChecked": { "type": "boolean" },
          "steps": {
            "type": "array",
            "maxItems": 40,
            "items": { "enum": ["find-posting", "save-posting", "save-application", "save-answers", "owner-message", "submit-click", "success-page", "set-status"] }
          },
          "note": { "type": "string", "maxLength": 200 }
        }
      }
    },
    "capCount": { "type": "integer", "minimum": 0, "maximum": 25 },
    "duplicateCount": { "type": "integer", "minimum": 0 },
    "droppedSites": { "type": "array", "maxItems": 50, "items": { "type": "string", "minLength": 1, "maxLength": 300 } },
    "endReason": {
      "enum": ["done", "cap-reached", "budget", "repeated-gates", "owner-away", "no-sites-left", "no-postings", "setup-incomplete", "browser-unavailable", "upload-failed"]
    },
    "database": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "schemaVersion", "runRowOpened", "runRowClosed", "trackerRegenerated"],
      "properties": {
        "file": { "const": "applications.db" },
        "schemaVersion": { "const": 1 },
        "runId": { "type": "integer", "minimum": 1 },
        "runRowOpened": { "type": "boolean" },
        "runRowClosed": { "type": "boolean" },
        "trackerRegenerated": { "type": "boolean" }
      }
    },
    "digestSent": { "type": "boolean" }
  }
}
